{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:futebol-brasileiro:database:v1",
  "title": "Futebol Brasileiro - club and player database v1",
  "description": "Bare JSON catalog. Strict UTF-8 JSON, at most 1 MiB and depth 32. Integer-valued fields must use integer tokens (no decimals/exponents). Runtime also validates unique identities, membership ownership and foreign references. Sports competitions and media packages are outside v1.",
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "club": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "acceleration",
        "topSpeed",
        "dribbleSpeed",
        "jump",
        "tackling",
        "ballKeeping",
        "passing",
        "longBall",
        "agility",
        "shooting",
        "shootPower",
        "positioning",
        "reaction",
        "ballControl"
      ],
      "properties": {
        "strength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "acceleration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "topSpeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dribbleSpeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "jump": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tackling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ballKeeping": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "passing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "longBall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "agility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "shooting": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "shootPower": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "positioning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reaction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ballControl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "naturalPositions",
        "heightCm",
        "weightKg",
        "attributes"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "naturalPositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "GK",
              "RB",
              "LB",
              "CB",
              "DM",
              "CM",
              "RM",
              "LM",
              "AM",
              "LW",
              "RW",
              "ST"
            ]
          },
          "uniqueItems": true,
          "maxItems": 12
        },
        "heightCm": {
          "type": "integer",
          "minimum": 150,
          "maximum": 210
        },
        "weightKg": {
          "type": "integer",
          "minimum": 45,
          "maximum": 100
        },
        "attributes": {
          "$ref": "#/definitions/attributes"
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clubId",
        "playerId"
      ],
      "properties": {
        "clubId": {
          "$ref": "#/definitions/id"
        },
        "playerId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinId",
        "revision",
        "compatibilityProfile"
      ],
      "properties": {
        "skinId": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "compatibilityProfile": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "visualProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId",
        "skin"
      ],
      "properties": {
        "playerId": {
          "$ref": "#/definitions/id"
        },
        "skin": {
          "$ref": "#/definitions/skin"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "databaseId",
    "databaseRevision",
    "clubs",
    "players",
    "memberships",
    "visualProfiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "databaseId": {
      "$ref": "#/definitions/id"
    },
    "databaseRevision": {
      "$ref": "#/definitions/revision"
    },
    "clubs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/club"
      }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/player"
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/definitions/membership"
      }
    },
    "visualProfiles": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/definitions/visualProfile"
      }
    }
  }
}
