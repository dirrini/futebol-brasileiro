{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:futebol-brasileiro:database:v6",
  "title": "Futebol Brasileiro database v6",
  "description": "Reusable declarative competition formats, stage schedules, eligibility and competition metadata; v1-v5 remain separate supported contracts.",
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "club": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "countryCode",
        "city"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "countryCode": {
          "$ref": "#/definitions/countryCode"
        },
        "city": {
          "$ref": "#/definitions/name"
        },
        "officialName": {
          "$ref": "#/definitions/longName"
        },
        "shortName": {
          "$ref": "#/definitions/name"
        },
        "stadiumId": {
          "$ref": "#/definitions/id"
        },
        "reputation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "supporterCount": {
          "$ref": "#/definitions/nonnegativeInteger"
        },
        "transferBudget": {
          "$ref": "#/definitions/nonnegativeInteger"
        },
        "monthlyWageBudget": {
          "$ref": "#/definitions/nonnegativeInteger"
        },
        "currency": {
          "$ref": "#/definitions/currencyCode"
        },
        "sponsorship": {
          "$ref": "#/definitions/longName"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        },
        "stateCode": {
          "$ref": "#/definitions/stateCode"
        }
      },
      "dependencies": {
        "transferBudget": [
          "currency"
        ],
        "monthlyWageBudget": [
          "currency"
        ]
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "acceleration",
        "topSpeed",
        "dribbleSpeed",
        "jump",
        "tackling",
        "ballKeeping",
        "passing",
        "longBall",
        "agility",
        "shooting",
        "shootPower",
        "positioning",
        "reaction",
        "ballControl"
      ],
      "properties": {
        "strength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "acceleration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "topSpeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dribbleSpeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "jump": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tackling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ballKeeping": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "passing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "longBall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "agility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "shooting": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "shootPower": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "positioning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reaction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ballControl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "naturalPositions",
        "heightCm",
        "weightKg",
        "attributes"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "naturalPositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "GK",
              "RB",
              "LB",
              "CB",
              "DM",
              "CM",
              "RM",
              "LM",
              "AM",
              "LW",
              "RW",
              "ST"
            ]
          },
          "uniqueItems": true,
          "maxItems": 12
        },
        "heightCm": {
          "type": "integer",
          "minimum": 150,
          "maximum": 210
        },
        "weightKg": {
          "type": "integer",
          "minimum": 45,
          "maximum": 100
        },
        "attributes": {
          "$ref": "#/definitions/attributes"
        },
        "fullName": {
          "$ref": "#/definitions/longName"
        },
        "nickname": {
          "$ref": "#/definitions/name"
        },
        "birthDate": {
          "$ref": "#/definitions/calendarDate"
        },
        "preferredFoot": {
          "enum": [
            "right",
            "left",
            "both"
          ]
        },
        "nationalityCode": {
          "$ref": "#/definitions/countryCode"
        },
        "notes": {
          "$ref": "#/definitions/notes"
        }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clubId",
        "playerId"
      ],
      "properties": {
        "clubId": {
          "$ref": "#/definitions/id"
        },
        "playerId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinId",
        "revision",
        "compatibilityProfile"
      ],
      "properties": {
        "skinId": {
          "$ref": "#/definitions/id"
        },
        "revision": {
          "$ref": "#/definitions/revision"
        },
        "compatibilityProfile": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "visualProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId",
        "skin"
      ],
      "properties": {
        "playerId": {
          "$ref": "#/definitions/id"
        },
        "skin": {
          "$ref": "#/definitions/skin"
        },
        "appearance": {
          "$ref": "#/definitions/appearance"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "appearance"
            ]
          },
          "then": {
            "properties": {
              "skin": {
                "type": "object",
                "properties": {
                  "skinId": {
                    "const": "builtin-player"
                  },
                  "revision": {
                    "const": 1
                  },
                  "compatibilityProfile": {
                    "const": "football-player-v1"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinTone",
        "hairStyle",
        "hairColor",
        "beardStyle",
        "beardColor",
        "bootsColor",
        "sockAccessoryColor"
      ],
      "properties": {
        "skinTone": {
          "type": "string",
          "enum": [
            "tone-1",
            "tone-2",
            "tone-3",
            "tone-4",
            "tone-5",
            "tone-6"
          ]
        },
        "hairStyle": {
          "type": "string",
          "enum": [
            "none",
            "short",
            "styled",
            "styled-alt",
            "mohawk",
            "locs",
            "short-parted"
          ]
        },
        "hairColor": {
          "type": "string",
          "enum": [
            "brown",
            "dark-brown",
            "black",
            "light-yellow",
            "yellow",
            "gray",
            "white",
            "green",
            "dark-green",
            "blue",
            "dark-blue",
            "light-red",
            "red",
            "light-orange",
            "orange"
          ]
        },
        "beardStyle": {
          "type": "string",
          "enum": [
            "none",
            "mustache",
            "goatee",
            "full"
          ]
        },
        "beardColor": {
          "type": "string",
          "enum": [
            "brown",
            "dark-brown",
            "black",
            "light-yellow",
            "yellow",
            "gray",
            "white",
            "green",
            "dark-green",
            "blue",
            "dark-blue",
            "light-red",
            "red",
            "light-orange",
            "orange"
          ]
        },
        "bootsColor": {
          "type": "string",
          "enum": [
            "black",
            "red",
            "orange",
            "purple",
            "cyan",
            "gray",
            "white"
          ]
        },
        "sockAccessoryColor": {
          "type": "string",
          "enum": [
            "none",
            "black",
            "gray",
            "white"
          ]
        }
      }
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "defaultFormatId": {
          "$ref": "#/definitions/id"
        },
        "level": {
          "enum": [
            "state",
            "regional",
            "national",
            "continental",
            "world"
          ]
        },
        "reputation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "prizeLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "logoUri": {
          "$ref": "#/definitions/mediaUri"
        },
        "trophyImageUri": {
          "$ref": "#/definitions/mediaUri"
        },
        "trophyModelUri": {
          "$ref": "#/definitions/mediaUri"
        },
        "eligibility": {
          "$ref": "#/definitions/competitionEligibility"
        },
        "qualificationRoutes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/qualificationRoute"
          }
        },
        "prizes": {
          "$ref": "#/definitions/competitionPrizes"
        }
      }
    },
    "gameDate": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    },
    "leagueRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "legs",
        "points",
        "tieBreakers"
      ],
      "properties": {
        "type": {
          "const": "round-robin"
        },
        "version": {
          "const": 1,
          "type": "integer"
        },
        "legs": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "points": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "win",
            "draw",
            "loss"
          ],
          "properties": {
            "win": {
              "maximum": 100,
              "type": "integer",
              "minimum": 0
            },
            "draw": {
              "maximum": 100,
              "type": "integer",
              "minimum": 0
            },
            "loss": {
              "maximum": 100,
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tieBreakers": {
          "const": [
            "wins",
            "goal-difference",
            "goals-for"
          ],
          "type": "array"
        }
      }
    },
    "competitionEdition": {
      "oneOf": [
        {
          "$ref": "#/definitions/legacyCompetitionEdition"
        },
        {
          "$ref": "#/definitions/formatEdition"
        }
      ]
    },
    "longName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}(?![\\s\\S])"
    },
    "currencyCode": {
      "type": "string",
      "pattern": "^[A-Z]{3}(?![\\s\\S])"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "calendarDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/countryCode"
        },
        "name": {
          "$ref": "#/definitions/name"
        }
      }
    },
    "stadium": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "countryCode",
        "city"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "countryCode": {
          "$ref": "#/definitions/countryCode"
        },
        "city": {
          "$ref": "#/definitions/name"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "$ref": "#/definitions/longName"
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF/?#]+(?:[/?#][^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]*)?(?![\\s\\S])"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "label",
        "rosterScope",
        "notes",
        "sources"
      ],
      "properties": {
        "date": {
          "$ref": "#/definitions/calendarDate"
        },
        "label": {
          "$ref": "#/definitions/name"
        },
        "rosterScope": {
          "enum": [
            "matchday-squads",
            "full-squads"
          ]
        },
        "notes": {
          "$ref": "#/definitions/notes"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/source"
          }
        }
      }
    },
    "paulistaRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "legs",
        "points",
        "tieBreakers"
      ],
      "properties": {
        "type": {
          "const": "paulista-2026"
        },
        "version": {
          "const": 1,
          "type": "integer"
        },
        "legs": {
          "const": 1,
          "type": "integer"
        },
        "points": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "win",
            "draw",
            "loss"
          ],
          "properties": {
            "win": {
              "const": 3,
              "type": "integer"
            },
            "draw": {
              "const": 1,
              "type": "integer"
            },
            "loss": {
              "const": 0,
              "type": "integer"
            }
          }
        },
        "tieBreakers": {
          "const": [
            "wins",
            "goal-difference",
            "goals-for",
            "red-cards",
            "yellow-cards",
            "drawing-lots"
          ],
          "type": "array"
        }
      }
    },
    "authoredFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "round",
        "date",
        "homeClubId",
        "awayClubId"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "date": {
          "$ref": "#/definitions/gameDate"
        },
        "homeClubId": {
          "$ref": "#/definitions/id"
        },
        "awayClubId": {
          "$ref": "#/definitions/id"
        },
        "stadiumId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "stateCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,8}(?![\\s\\S])"
    },
    "mediaUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?:https://[^\\s/?#]+(?:[/?#][^\\s]*)?|[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*)(?![\\s\\S])"
    },
    "competitionEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryCodes",
        "stateCodes",
        "allowedClubIds",
        "excludedClubIds"
      ],
      "properties": {
        "countryCodes": {
          "type": "array",
          "maxItems": 300,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/countryCode"
          }
        },
        "stateCodes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/stateCode"
          }
        },
        "allowedClubIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        },
        "excludedClubIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "formatPoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "win",
        "draw",
        "loss"
      ],
      "properties": {
        "win": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "draw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "loss": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "formatQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "count"
      ],
      "properties": {
        "mode": {
          "enum": [
            "overall",
            "per-group",
            "winners"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rankingStageIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "formatStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "groupCount",
        "opponents",
        "legs",
        "roundCount",
        "points",
        "tieBreakers",
        "qualification",
        "pairing",
        "venue",
        "awayGoals",
        "tiedWinner"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/name"
        },
        "kind": {
          "enum": [
            "league",
            "knockout"
          ]
        },
        "groupCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "opponents": {
          "enum": [
            "all",
            "same-group",
            "cross-group",
            "authored"
          ]
        },
        "legs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "roundCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "points": {
          "$ref": "#/definitions/formatPoints"
        },
        "tieBreakers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "wins",
              "goal-difference",
              "goals-for",
              "red-cards",
              "yellow-cards",
              "seeded-draw"
            ]
          }
        },
        "qualification": {
          "$ref": "#/definitions/formatQualification"
        },
        "pairing": {
          "enum": [
            "seeded",
            "draw",
            "cross-group"
          ]
        },
        "venue": {
          "enum": [
            "seeded",
            "first-listed",
            "draw",
            "neutral"
          ]
        },
        "awayGoals": {
          "type": "boolean"
        },
        "tiedWinner": {
          "enum": [
            "penalties",
            "higher-seed"
          ]
        },
        "source": {
          "$ref": "#/definitions/stageSource"
        }
      }
    },
    "formatOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "stageId",
        "kind",
        "ranking",
        "fromRank",
        "toRank"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "$ref": "#/definitions/name"
        },
        "stageId": {
